# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal docs / agent instructions - not pushed to remote
/docs
/AGENTS.md
/CLAUDE.md

# bun.lock is lockfileVersion 2 (bun 1.4+); Vercel's build image still
# ships bun 1.3.x which can't parse it. Let each install generate its own.
/bun.lock
